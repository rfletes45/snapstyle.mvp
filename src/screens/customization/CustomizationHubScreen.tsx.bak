/**
 * CustomizationHubScreen
 *
 * Unified customization screen where users can browse, preview,
 * equip, and purchase cosmetics (Decorations, Backgrounds, Badges,
 * Themes).
 *
 * Layout (top → bottom):
 *   1. Live-preview ProfileHeaderVisual (shows try-on overrides)
 *   2. Category tab bar
 *   3. Search input
 *   4. Scrollable item grid
 *
 * @module screens/customization/CustomizationHubScreen
 */

import { MaterialCommunityIcons } from "@expo/vector-icons";
import React, { useCallback, useEffect, useMemo, useState } from "react";
import {
  Alert,
  Dimensions,
  FlatList,
  Image,
  Pressable,
  ScrollView,
  StyleSheet,
  View,
} from "react-native";
import { Appbar, Chip, Searchbar, Text } from "react-native-paper";
import { useSafeAreaInsets } from "react-native-safe-area-context";

import { ProfileHeaderVisual } from "@/components/profile/ProfileHeaderVisual";
import { BorderRadius, Spacing } from "@/constants/theme";
import { getCosmeticAsset, hasCosmeticAsset } from "@/cosmetics/assetRegistry";
import { getCosmeticById } from "@/cosmetics/catalog";
import {
  FEATURED_ITEMS,
  getBundleDiscount,
  getBundleUnownedIds,
  isBundleFullyOwned,
  STORE_BUNDLES,
} from "@/cosmetics/storeCurations";
import type {
  CosmeticBundle,
  CosmeticDefinition,
  FeaturedItem,
} from "@/cosmetics/types";
import {
  CUSTOMIZATION_TABS,
  useCustomizationHub,
} from "@/hooks/useCustomizationHub";
import { useProfileData } from "@/hooks/useProfileData";
import { useProfilePicture } from "@/hooks/useProfilePicture";
import { formatTokenAmount } from "@/services/economy";
import { useAuth } from "@/store/AuthContext";
import { useAppTheme, useColors } from "@/store/ThemeContext";
import { useUser } from "@/store/UserContext";
import { ItemDetailSheet } from "./ItemDetailSheet";

import { createLogger } from "@/utils/log";
import { ActivityIndicator } from "react-native";

const logger = createLogger("screens/customization/CustomizationHubScreen");

const { width: SCREEN_WIDTH } = Dimensions.get("window");
const GRID_COLUMNS = 3;
const GRID_GAP = Spacing.sm;
const GRID_PADDING = Spacing.lg;
const ITEM_SIZE =
  (SCREEN_WIDTH - GRID_PADDING * 2 - GRID_GAP * (GRID_COLUMNS - 1)) /
  GRID_COLUMNS;

// =============================================================================
// Types
// =============================================================================

interface CustomizationHubScreenProps {
  navigation: any;
  route?: { params?: { initialTab?: string } };
}

// =============================================================================
// Rarity Colors
// =============================================================================

const RARITY_COLORS: Record<string, string> = {
  common: "#9E9E9E",
  uncommon: "#4CAF50",
  rare: "#2196F3",
  epic: "#9C27B0",
  legendary: "#FF9800",
  mythic: "#F44336",
};

// =============================================================================
// Grid Item
// =============================================================================

interface GridItemProps {
  item: CosmeticDefinition;
  isOwned: boolean;
  isEquipped: boolean;
  onPress: (item: CosmeticDefinition) => void;
}

function GridItem({ item, isOwned, isEquipped, onPress }: GridItemProps) {
  const colors = useColors();
  const hasAsset = hasCosmeticAsset(item.type, item.assetKey ?? item.id);
  const assetSource = hasAsset
    ? getCosmeticAsset(item.type, item.assetKey ?? item.id)
    : null;
  const rarityColor = RARITY_COLORS[item.rarity] ?? colors.textSecondary;

  return (
    <Pressable
      onPress={() => onPress(item)}
      style={({ pressed }) => [
        styles.gridItem,
        {
          backgroundColor: colors.surfaceVariant,
          borderColor: isEquipped ? colors.primary : rarityColor + "30",
          opacity: pressed ? 0.8 : 1,
        },
      ]}
    >
      {/* Image or placeholder */}
      {assetSource ? (
        <Image
          source={assetSource}
          style={styles.gridItemImage}
          resizeMode="cover"
        />
      ) : (
        <View
          style={[
            styles.gridItemPlaceholder,
            { backgroundColor: rarityColor + "15" },
          ]}
        >
          <MaterialCommunityIcons
            name={
              item.type === "badge"
                ? "shield-star"
                : item.type === "theme"
                  ? "palette"
                  : "image"
            }
            size={28}
            color={rarityColor}
          />
        </View>
      )}

      {/* Name */}
      <Text
        style={[styles.gridItemName, { color: colors.text }]}
        numberOfLines={1}
      >
        {item.name}
      </Text>

      {/* Status badge */}
      {isEquipped ? (
        <View style={[styles.statusBadge, { backgroundColor: colors.primary }]}>
          <MaterialCommunityIcons name="check" size={10} color="#fff" />
        </View>
      ) : !isOwned && item.source === "shop" && item.priceTokens ? (
        <View style={[styles.priceBadge, { backgroundColor: colors.surface }]}>
          <MaterialCommunityIcons
            name="star-circle"
            size={10}
            color={colors.primary}
          />
          <Text style={[styles.priceText, { color: colors.text }]}>
            {formatTokenAmount(item.priceTokens)}
          </Text>
        </View>
      ) : !isOwned ? (
        <View
          style={[
            styles.statusBadge,
            { backgroundColor: colors.textSecondary + "60" },
          ]}
        >
          <MaterialCommunityIcons name="lock" size={10} color="#fff" />
        </View>
      ) : null}

      {/* Rarity dot */}
      <View style={[styles.rarityDot, { backgroundColor: rarityColor }]} />
    </Pressable>
  );
}

// =============================================================================
// Featured Card (horizontal carousel)
// =============================================================================

const FEATURED_CARD_WIDTH = SCREEN_WIDTH * 0.65;

const BADGE_COLORS: Record<string, string> = {
  NEW: "#4CAF50",
  HOT: "#FF5722",
  SALE: "#E91E63",
  LIMITED: "#FF9800",
};

interface FeaturedCardProps {
  featured: FeaturedItem;
  cosmetic: CosmeticDefinition;
  isOwned: boolean;
  onPress: (item: CosmeticDefinition) => void;
}

function FeaturedCard({
  featured,
  cosmetic,
  isOwned,
  onPress,
}: FeaturedCardProps) {
  const colors = useColors();
  const hasAsset = hasCosmeticAsset(
    cosmetic.type,
    cosmetic.assetKey ?? cosmetic.id,
  );
  const assetSource = hasAsset
    ? getCosmeticAsset(cosmetic.type, cosmetic.assetKey ?? cosmetic.id)
    : null;

  return (
    <Pressable
      onPress={() => onPress(cosmetic)}
      style={({ pressed }) => [
        styles.featuredCard,
        {
          backgroundColor: colors.surfaceVariant,
          opacity: pressed ? 0.85 : 1,
        },
      ]}
    >
      {/* Image */}
      {assetSource ? (
        <Image
          source={assetSource}
          style={styles.featuredCardImage}
          resizeMode="cover"
        />
      ) : (
        <View
          style={[
            styles.featuredCardPlaceholder,
            { backgroundColor: colors.primary + "15" },
          ]}
        >
          <MaterialCommunityIcons
            name={
              cosmetic.type === "decoration"
                ? "star-circle"
                : cosmetic.type === "theme"
                  ? "palette"
                  : "image"
            }
            size={36}
            color={colors.primary}
          />
        </View>
      )}

      {/* Badge */}
      {featured.badge && (
        <View
          style={[
            styles.featuredBadge,
            { backgroundColor: BADGE_COLORS[featured.badge] ?? colors.primary },
          ]}
        >
          <Text style={styles.featuredBadgeText}>{featured.badge}</Text>
        </View>
      )}

      {/* Info overlay */}
      <View style={styles.featuredInfo}>
        <Text
          style={[styles.featuredHeadline, { color: colors.textSecondary }]}
          numberOfLines={1}
        >
          {featured.headline}
        </Text>
        <Text
          style={[styles.featuredName, { color: colors.text }]}
          numberOfLines={1}
        >
          {cosmetic.name}
        </Text>
        {featured.subtitle && (
          <Text
            style={[styles.featuredSubtitle, { color: colors.textSecondary }]}
            numberOfLines={1}
          >
            {featured.subtitle}
          </Text>
        )}

        {/* Price / status */}
        <View style={styles.featuredPriceRow}>
          {isOwned ? (
            <View
              style={[
                styles.featuredOwnedBadge,
                { backgroundColor: colors.primary + "20" },
              ]}
            >
              <MaterialCommunityIcons
                name="check-circle"
                size={12}
                color={colors.primary}
              />
              <Text
                style={[styles.featuredOwnedText, { color: colors.primary }]}
              >
                Owned
              </Text>
            </View>
          ) : cosmetic.priceTokens ? (
            <View style={styles.featuredPriceChip}>
              <MaterialCommunityIcons
                name="star-circle"
                size={14}
                color={colors.primary}
              />
              <Text style={[styles.featuredPriceText, { color: colors.text }]}>
                {formatTokenAmount(cosmetic.priceTokens)}
              </Text>
            </View>
          ) : (
            <Text style={[styles.featuredFreeText, { color: colors.primary }]}>
              Free
            </Text>
          )}
        </View>
      </View>
    </Pressable>
  );
}

// =============================================================================
// Bundle Card
// =============================================================================

interface BundleCardProps {
  bundle: CosmeticBundle;
  ownedIds: Set<string>;
  onPress: (bundle: CosmeticBundle) => void;
}

function BundleCard({ bundle, ownedIds, onPress }: BundleCardProps) {
  const colors = useColors();
  const discount = getBundleDiscount(bundle);
  const fullyOwned = isBundleFullyOwned(bundle, ownedIds);
  const unownedCount = getBundleUnownedIds(bundle, ownedIds).length;
  const rarityColor = RARITY_COLORS[bundle.rarity] ?? colors.textSecondary;

  // Show first item's image as bundle preview
  const firstItem = getCosmeticById(bundle.cosmeticIds[0]);
  const hasAsset =
    firstItem &&
    hasCosmeticAsset(firstItem.type, firstItem.assetKey ?? firstItem.id);
  const assetSource =
    firstItem && hasAsset
      ? getCosmeticAsset(firstItem.type, firstItem.assetKey ?? firstItem.id)
      : null;

  return (
    <Pressable
      onPress={() => onPress(bundle)}
      style={({ pressed }) => [
        styles.bundleCard,
        {
          backgroundColor: colors.surfaceVariant,
          borderColor: rarityColor + "40",
          opacity: pressed ? 0.85 : 1,
        },
      ]}
    >
      {/* Preview image */}
      <View style={styles.bundleImageWrapper}>
        {assetSource ? (
          <Image
            source={assetSource}
            style={styles.bundleImage}
            resizeMode="cover"
          />
        ) : (
          <View
            style={[
              styles.bundlePlaceholder,
              { backgroundColor: rarityColor + "15" },
            ]}
          >
            <MaterialCommunityIcons
              name="package-variant"
              size={28}
              color={rarityColor}
            />
          </View>
        )}

        {/* Discount badge */}
        {discount > 0 && !fullyOwned && (
          <View style={[styles.discountBadge, { backgroundColor: "#E91E63" }]}>
            <Text style={styles.discountText}>-{discount}%</Text>
          </View>
        )}
      </View>

      {/* Info */}
      <View style={styles.bundleInfo}>
        <View style={styles.bundleNameRow}>
          <Text
            style={[styles.bundleName, { color: colors.text }]}
            numberOfLines={1}
          >
            {bundle.name}
          </Text>
          {bundle.badge && (
            <View
              style={[styles.bundleBadge, { backgroundColor: rarityColor }]}
            >
              <Text style={styles.bundleBadgeText}>{bundle.badge}</Text>
            </View>
          )}
        </View>
        <Text
          style={[styles.bundleDesc, { color: colors.textSecondary }]}
          numberOfLines={2}
        >
          {bundle.description}
        </Text>
        <Text style={[styles.bundleItemCount, { color: colors.textSecondary }]}>
          {bundle.cosmeticIds.length} items
          {fullyOwned
            ? " • All owned ✓"
            : unownedCount < bundle.cosmeticIds.length
              ? ` • ${unownedCount} left to unlock`
              : ""}
        </Text>

        {/* Price */}
        <View style={styles.bundlePriceRow}>
          {fullyOwned ? (
            <View
              style={[
                styles.featuredOwnedBadge,
                { backgroundColor: colors.primary + "20" },
              ]}
            >
              <MaterialCommunityIcons
                name="check-circle"
                size={12}
                color={colors.primary}
              />
              <Text
                style={[styles.featuredOwnedText, { color: colors.primary }]}
              >
                Owned
              </Text>
            </View>
          ) : (
            <>
              <Text
                style={[
                  styles.bundleOrigPrice,
                  { color: colors.textSecondary },
                ]}
              >
                {formatTokenAmount(bundle.originalPriceTokens)}
              </Text>
              <View style={styles.featuredPriceChip}>
                <MaterialCommunityIcons
                  name="star-circle"
                  size={14}
                  color={colors.primary}
                />
                <Text style={[styles.bundleSalePrice, { color: colors.text }]}>
                  {formatTokenAmount(bundle.priceTokens)}
                </Text>
              </View>
            </>
          )}
        </View>
      </View>
    </Pressable>
  );
}

// =============================================================================
// Screen
// =============================================================================

export default function CustomizationHubScreen({
  navigation,
  route,
}: CustomizationHubScreenProps) {
  const colors = useColors();
  const { setTheme: setAppTheme } = useAppTheme();
  const insets = useSafeAreaInsets();
  const { currentFirebaseUser } = useAuth();
  const uid = currentFirebaseUser?.uid ?? "";
  const { profile: baseProfile } = useUser();
  const { profile } = useProfileData(uid);
  const { picture, decoration } = useProfilePicture({ userId: uid });

  // Apply initialTab from route params (for cross-tab navigation, e.g. achievements → equip badge)
  const initialTab = route?.params?.initialTab;

  // Current equipped state
  const currentDecorationId = decoration?.decorationId ?? null;
  const currentBackgroundId = (profile as any)?.equippedBackgroundId ?? null;
  const currentThemeId = (profile as any)?.theme?.equippedThemeId ?? "default";
  const currentBadgeIds: string[] =
    (profile as any)?.featuredBadges?.badgeIds ?? [];

  // Hub hook
  const hub = useCustomizationHub({
    uid,
    currentDecorationId,
    currentBackgroundId,
    currentThemeId,
    currentBadgeIds,
    setAppTheme,
  });

  // Apply initialTab from route params on mount
  useEffect(() => {
    if (
      initialTab &&
      ["decoration", "background", "badge", "theme"].includes(initialTab)
    ) {
      hub.setActiveTab(
        initialTab as "decoration" | "background" | "badge" | "theme",
      );
    }
    // Only run on mount
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // Item detail sheet
  const [selectedItem, setSelectedItem] = useState<CosmeticDefinition | null>(
    null,
  );
  const [detailVisible, setDetailVisible] = useState(false);

  const handleItemPress = useCallback((item: CosmeticDefinition) => {
    setSelectedItem(item);
    setDetailVisible(true);
  }, []);

  const handleCloseDetail = useCallback(() => {
    setDetailVisible(false);
  }, []);

  const handleEquip = useCallback(
    async (item: CosmeticDefinition) => {
      try {
        await hub.equipItem(item);
        setDetailVisible(false);
      } catch (error: any) {
        Alert.alert("Error", error?.message || "Failed to equip item");
      }
    },
    [hub],
  );

  const handlePurchase = useCallback(
    async (cosmeticId: string) => {
      const result = await hub.purchaseItem(cosmeticId);
      if (result.success) {
        Alert.alert("Success!", "Item purchased and added to your collection.");
        setDetailVisible(false);
      } else {
        Alert.alert("Purchase Failed", result.error || "Something went wrong.");
      }
    },
    [hub],
  );

  // Determine if selected item is equipped
  const isSelectedEquipped = useMemo(() => {
    if (!selectedItem) return false;
    switch (selectedItem.type) {
      case "decoration":
        return currentDecorationId === selectedItem.id;
      case "background":
        return currentBackgroundId === selectedItem.id;
      case "theme":
        return currentThemeId === selectedItem.id;
      case "badge":
        return currentBadgeIds.includes(selectedItem.id);
      default:
        return false;
    }
  }, [
    selectedItem,
    currentDecorationId,
    currentBackgroundId,
    currentThemeId,
    currentBadgeIds,
  ]);

  // ── Render ────────────────────────────────────────────────────────────────

  const renderGridItem = useCallback(
    ({ item }: { item: CosmeticDefinition }) => {
      const isEquipped = (() => {
        switch (item.type) {
          case "decoration":
            return currentDecorationId === item.id;
          case "background":
            return currentBackgroundId === item.id;
          case "theme":
            return currentThemeId === item.id;
          case "badge":
            return currentBadgeIds.includes(item.id);
          default:
            return false;
        }
      })();

      return (
        <GridItem
          item={item}
          isOwned={hub.isOwned(item.id)}
          isEquipped={isEquipped}
          onPress={handleItemPress}
        />
      );
    },
    [
      hub,
      handleItemPress,
      currentDecorationId,
      currentBackgroundId,
      currentThemeId,
      currentBadgeIds,
    ],
  );

  const keyExtractor = useCallback((item: CosmeticDefinition) => item.id, []);

  // ── Featured items (resolved from catalog) ────────────────────────────────
  const resolvedFeatured = useMemo(() => {
    if (hub.viewMode !== "shop") return [];
    return FEATURED_ITEMS.map((f) => ({
      featured: f,
      cosmetic: getCosmeticById(f.cosmeticId),
    })).filter(
      (
        entry,
      ): entry is { featured: FeaturedItem; cosmetic: CosmeticDefinition } =>
        entry.cosmetic != null,
    );
  }, [hub.viewMode]);

  // ── Bundle press handler ──────────────────────────────────────────────────
  const handleBundlePress = useCallback(
    (bundle: CosmeticBundle) => {
      const fullyOwned = isBundleFullyOwned(bundle, hub.ownedSet);
      if (fullyOwned) {
        Alert.alert(
          "Already Owned",
          "You already own all items in this bundle.",
        );
        return;
      }
      const unowned = getBundleUnownedIds(bundle, hub.ownedSet);
      const discount = getBundleDiscount(bundle);
      Alert.alert(
        bundle.name,
        `${bundle.description}\n\n${unowned.length} items for ${formatTokenAmount(bundle.priceTokens)} tokens (save ${discount}%)`,
        [
          { text: "Cancel", style: "cancel" },
          {
            text: `Buy for ${formatTokenAmount(bundle.priceTokens)}`,
            onPress: async () => {
              // Purchase each unowned item individually
              for (const itemId of unowned) {
                const result = await hub.purchaseItem(itemId);
                if (!result.success) {
                  Alert.alert(
                    "Bundle Purchase Error",
                    `Failed on ${itemId}: ${result.error}`,
                  );
                  return;
                }
              }
              Alert.alert(
                "Bundle Complete!",
                "All items added to your collection.",
              );
            },
          },
        ],
      );
    },
    [hub],
  );

  // ── Shop header (featured + bundles) ──────────────────────────────────────
  const ShopListHeader = useMemo(() => {
    if (hub.viewMode !== "shop" || hub.searchQuery.trim()) return null;

    return (
      <View>
        {/* Featured Section */}
        {resolvedFeatured.length > 0 && (
          <View style={styles.sectionContainer}>
            <View style={styles.sectionHeaderRow}>
              <MaterialCommunityIcons
                name="fire"
                size={18}
                color={colors.primary}
              />
              <Text style={[styles.sectionTitle, { color: colors.text }]}>
                Featured
              </Text>
            </View>
            <ScrollView
              horizontal
              showsHorizontalScrollIndicator={false}
              contentContainerStyle={styles.featuredScroll}
            >
              {resolvedFeatured.map(({ featured, cosmetic }) => (
                <FeaturedCard
                  key={cosmetic.id}
                  featured={featured}
                  cosmetic={cosmetic}
                  isOwned={hub.isOwned(cosmetic.id)}
                  onPress={handleItemPress}
                />
              ))}
            </ScrollView>
          </View>
        )}

        {/* Bundles Section */}
        {STORE_BUNDLES.length > 0 && (
          <View style={styles.sectionContainer}>
            <View style={styles.sectionHeaderRow}>
              <MaterialCommunityIcons
                name="package-variant"
                size={18}
                color={colors.primary}
              />
              <Text style={[styles.sectionTitle, { color: colors.text }]}>
                Bundles
              </Text>
            </View>
            {STORE_BUNDLES.map((bundle) => (
              <BundleCard
                key={bundle.id}
                bundle={bundle}
                ownedIds={hub.ownedSet}
                onPress={handleBundlePress}
              />
            ))}
          </View>
        )}

        {/* "All Items" section header */}
        {hub.filteredItems.length > 0 && (
          <View style={styles.sectionHeaderRow}>
            <MaterialCommunityIcons
              name="view-grid"
              size={18}
              color={colors.primary}
            />
            <Text style={[styles.sectionTitle, { color: colors.text }]}>
              All{" "}
              {CUSTOMIZATION_TABS.find((t) => t.id === hub.activeTab)?.label ??
                "Items"}
            </Text>
          </View>
        )}
      </View>
    );
  }, [
    hub.viewMode,
    hub.searchQuery,
    hub.filteredItems.length,
    hub.activeTab,
    resolvedFeatured,
    handleItemPress,
    handleBundlePress,
    colors,
    hub.isOwned,
    hub.ownedSet,
  ]);

  if (!baseProfile) return null;

  return (
    <View style={[styles.container, { backgroundColor: colors.background }]}>
      {/* App bar */}
      <View style={{ paddingTop: insets.top }}>
        <Appbar.Header
          style={[styles.appbar, { backgroundColor: colors.background }]}
          statusBarHeight={0}
        >
          <Appbar.BackAction onPress={() => navigation.goBack()} />
          <Appbar.Content title="Customize" />
          {hub.hasPreview && (
            <Appbar.Action
              icon="check"
              onPress={async () => {
                try {
                  await hub.applyPreview();
                } catch (error: any) {
                  Alert.alert("Error", error?.message || "Failed to apply");
                }
              }}
            />
          )}
          {hub.hasPreview && (
            <Appbar.Action icon="close" onPress={hub.clearPreview} />
          )}
        </Appbar.Header>
      </View>

      {/* Live Preview Header */}
      <ProfileHeaderVisual
        displayName={baseProfile.displayName}
        username={baseProfile.username}
        pictureUrl={picture?.url ?? null}
        decorationId={currentDecorationId}
        backgroundId={currentBackgroundId}
        level={
          profile?.level ?? {
            current: 1,
            xp: 0,
            xpToNextLevel: 100,
            totalXp: 0,
          }
        }
        previewOverrides={hub.previewOverrides}
      />

      {/* Category Tabs */}
      <View style={styles.tabsContainer}>
        {CUSTOMIZATION_TABS.map((tab) => {
          const isActive = hub.activeTab === tab.id;
          return (
            <Pressable
              key={tab.id}
              onPress={() => hub.setActiveTab(tab.id)}
              style={[
                styles.tabItem,
                {
                  backgroundColor: isActive
                    ? colors.primary + "18"
                    : "transparent",
                  borderColor: isActive ? colors.primary : "transparent",
                },
              ]}
            >
              <MaterialCommunityIcons
                name={tab.icon as any}
                size={18}
                color={isActive ? colors.primary : colors.textSecondary}
              />
              <Text
                style={[
                  styles.tabLabel,
                  {
                    color: isActive ? colors.primary : colors.textSecondary,
                    fontWeight: isActive ? "600" : "400",
                  },
                ]}
              >
                {tab.label}
              </Text>
            </Pressable>
          );
        })}
      </View>

      {/* View Mode Toggle */}
      <View style={styles.viewModeRow}>
        {(["inventory", "shop"] as const).map((mode) => {
          const isActive = hub.viewMode === mode;
          return (
            <Pressable
              key={mode}
              onPress={() => hub.setViewMode(mode)}
              style={[
                styles.viewModeButton,
                {
                  backgroundColor: isActive
                    ? colors.primary
                    : colors.surfaceVariant,
                  borderColor: isActive
                    ? colors.primary
                    : colors.surfaceVariant,
                },
              ]}
            >
              <MaterialCommunityIcons
                name={mode === "inventory" ? "treasure-chest" : "store"}
                size={14}
                color={isActive ? "#fff" : colors.textSecondary}
              />
              <Text
                style={[
                  styles.viewModeLabel,
                  { color: isActive ? "#fff" : colors.textSecondary },
                ]}
              >
                {mode === "inventory" ? "My Items" : "Shop"}
              </Text>
            </Pressable>
          );
        })}
      </View>

      {/* Search */}
      <View style={styles.searchRow}>
        <Searchbar
          placeholder={`Search ${CUSTOMIZATION_TABS.find((t) => t.id === hub.activeTab)?.label ?? "items"}...`}
          value={hub.searchQuery}
          onChangeText={hub.setSearchQuery}
          style={[styles.searchbar, { backgroundColor: colors.surfaceVariant }]}
          inputStyle={styles.searchInput}
          elevation={0}
        />
      </View>

      {/* Wallet Balance Chip */}
      <View style={styles.walletRow}>
        <Chip
          compact
          icon={({ size, color }) => (
            <MaterialCommunityIcons
              name="star-circle"
              size={size}
              color={colors.primary}
            />
          )}
          style={{ backgroundColor: colors.surfaceVariant }}
          textStyle={{ fontSize: 12, color: colors.text }}
        >
          {formatTokenAmount(hub.walletBalance)} tokens
        </Chip>
        <Text style={[styles.itemCount, { color: colors.textSecondary }]}>
          {hub.filteredItems.length} item
          {hub.filteredItems.length !== 1 ? "s" : ""}
        </Text>
      </View>

      {/* Item Grid */}
      {hub.entitlementsLoading && hub.viewMode === "inventory" ? (
        <View style={styles.loadingContainer}>
          <ActivityIndicator size="large" color={colors.primary} />
          <Text style={[styles.loadingText, { color: colors.textSecondary }]}>
            Loading your items…
          </Text>
        </View>
      ) : (
        <FlatList
          data={hub.filteredItems}
          renderItem={renderGridItem}
          keyExtractor={keyExtractor}
          numColumns={GRID_COLUMNS}
          contentContainerStyle={styles.gridContent}
          columnWrapperStyle={styles.gridRow}
          showsVerticalScrollIndicator={false}
          ListHeaderComponent={ShopListHeader}
          ListEmptyComponent={
            <View style={styles.emptyContainer}>
              <MaterialCommunityIcons
                name={hub.viewMode === "inventory" ? "treasure-chest" : "store"}
                size={48}
                color={colors.textSecondary}
              />
              <Text style={[styles.emptyText, { color: colors.textSecondary }]}>
                {hub.viewMode === "inventory"
                  ? "No items yet — visit the Shop to get started!"
                  : "No items available for purchase"}
              </Text>
            </View>
          }
        />
      )}

      {/* Item Detail Sheet */}
      <ItemDetailSheet
        visible={detailVisible}
        item={selectedItem}
        isOwned={selectedItem ? hub.isOwned(selectedItem.id) : false}
        isEquipped={isSelectedEquipped}
        walletBalance={hub.walletBalance}
        purchasing={hub.purchasing}
        onClose={handleCloseDetail}
        onEquip={handleEquip}
        onUnequip={(type) => {
          hub.unequipSlot(type);
          setDetailVisible(false);
        }}
        onPurchase={handlePurchase}
        onPreview={(item) => {
          hub.previewItem(item);
        }}
      />
    </View>
  );
}

