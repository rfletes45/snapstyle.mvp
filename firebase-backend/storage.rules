rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    
    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Validate file size (in bytes)
    function validFileSize(maxBytes) {
      return request.resource.size <= maxBytes;
    }
    
    // Validate image content type
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    // Validate specific image types (jpg, png, gif, webp)
    function isValidImageType() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/gif',
        'image/webp'
      ];
    }
    
    // Validate UID format (Firebase Auth UIDs are 28 chars alphanumeric)
    // This helps prevent path traversal attacks
    function isValidUid(uid) {
      return uid.size() >= 20 && uid.size() <= 128 && uid.matches('[a-zA-Z0-9]+');
    }

    function isChatMember(chatId) {
      return isAuth() && (
        (firestore.exists(/databases/(default)/documents/Chats/$(chatId)) &&
          request.auth.uid in firestore.get(/databases/(default)/documents/Chats/$(chatId)).data.members) ||
        firestore.exists(/databases/(default)/documents/Chats/$(chatId)/Members/$(request.auth.uid))
      );
    }

    function isGroupMember(groupId) {
      return isAuth() &&
        firestore.exists(/databases/(default)/documents/Groups/$(groupId)/Members/$(request.auth.uid));
    }

    function isConversationMember(scope, conversationId) {
      return scope == 'dm'
        ? isChatMember(conversationId)
        : scope == 'group' && isGroupMember(conversationId);
    }

    function isValidChatMediaType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('audio/.*') ||
             request.resource.contentType in [
               'application/pdf',
               'application/msword',
               'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
               'text/plain',
               'application/json'
             ];
    }

    // ============================================================
    // PICTURES: Chat images between two users
    // ============================================================
    
    // Path: /pictures/{chatId}/{filename}
    // Chat ID format is uid1_uid2 (sorted alphabetically)
    match /pictures/{chatId}/{allPaths=**} {
      // Read: Only chat members (UID in chatId)
      // Strengthened: Exact boundary match with underscore
      allow read: if isChatMember(chatId) || (isAuth() && (
                    chatId.matches(request.auth.uid + '_.*') ||
                    chatId.matches('.*_' + request.auth.uid)
                  ));
      
      // Write: Only chat members, with validation
      allow write: if (isChatMember(chatId) || (isAuth() && (
                     chatId.matches(request.auth.uid + '_.*') ||
                     chatId.matches('.*_' + request.auth.uid)
                   ))) &&
                   // Must be an image
                   isValidImageType() &&
                   // Max 10MB per snap
                   validFileSize(10 * 1024 * 1024);
    }

    // Path: /snaps/{chatId}/{filename}
    // Current DM media upload path. Requires membership instead of only
    // parsing the chatId string, and limits files to chat-safe media types.
    match /snaps/{chatId}/{allPaths=**} {
      allow read: if isChatMember(chatId);
      allow write: if isChatMember(chatId) &&
                     isValidChatMediaType() &&
                     validFileSize(25 * 1024 * 1024);
    }

    // ============================================================
    // DM VOICE: Voice messages between two users
    // ============================================================
    
    // Path: /dm-voice/{chatId}/{filename}
    // Chat ID format is uid1_uid2 (sorted alphabetically)
    match /dm-voice/{chatId}/{allPaths=**} {
      // Read: Only chat members (UID in chatId)
      allow read: if isChatMember(chatId) || (isAuth() && (
                    chatId.matches(request.auth.uid + '_.*') ||
                    chatId.matches('.*_' + request.auth.uid)
                  ));
      
      // Write: Only chat members, with validation
      allow write: if (isChatMember(chatId) || (isAuth() && (
                     chatId.matches(request.auth.uid + '_.*') ||
                     chatId.matches('.*_' + request.auth.uid)
                   ))) &&
                   // Must be audio
                   request.resource.contentType.matches('audio/.*') &&
                   // Max 10MB per voice message
                   validFileSize(10 * 1024 * 1024);
    }

    // ============================================================
    // STORIES: User-posted stories visible to friends
    // ============================================================
    
    // Path: /stories/{authorId}/{filename}
    match /stories/{authorId}/{allPaths=**} {
      // Read: Any authenticated user can read story files
      // (Firestore rules handle access control via recipientIds)
      allow read: if isAuth();
      
      // Write: Only the author can upload to their directory
      // Added: UID format validation
      allow write: if isAuth() && 
                     request.auth.uid == authorId &&
                     isValidUid(authorId) &&
                     // Must be an image
                     isValidImageType() &&
                     // Max 10MB per story image
                     validFileSize(10 * 1024 * 1024);
    }

    // ============================================================
    // AVATARS: User profile images (future use)
    // ============================================================
    
    // Path: /avatars/{userId}/{filename}
    match /avatars/{userId}/{allPaths=**} {
      // Read: Anyone authenticated can view avatars
      allow read: if isAuth();
      
      // Write: Only owner can upload
      // Added: UID format validation
      allow write: if isAuth() && 
                     request.auth.uid == userId &&
                     isValidUid(userId) &&
                     isValidImageType() &&
                     // Max 5MB for avatars
                     validFileSize(5 * 1024 * 1024);
    }

    // ============================================================
    // USERS: User profile data (profile pictures, decorations, etc.)
    // ============================================================
    
    // Path: /users/{userId}/profile/{filename}
    // Used for profile pictures and related assets
    match /users/{userId}/profile/{filename} {
      // Read: Anyone authenticated can view profile pictures
      allow read: if isAuth();
      
      // Write: Only the owner can upload to their profile
      // Added: UID format validation
      allow write: if isAuth() && 
                     request.auth.uid == userId &&
                     isValidUid(userId) &&
                     isValidImageType() &&
                     // Max 5MB for profile pictures
                     validFileSize(5 * 1024 * 1024);
    }

    // ============================================================
    // GROUPS: Group chat images and attachments
    // ============================================================
    
    // Path: /groups/{groupId}/messages/{filename}
    match /groups/{groupId}/messages/{allPaths=**} {
      allow read: if isGroupMember(groupId);
      allow write: if isGroupMember(groupId) && 
                     isValidImageType() &&
                     // Max 10MB per group image
                     validFileSize(10 * 1024 * 1024);
    }
    
    // Path: /groups/{groupId}/attachments/{filename}
    // Used by GroupChatScreen for message attachments
    match /groups/{groupId}/attachments/{allPaths=**} {
      allow read: if isGroupMember(groupId);
      allow write: if isGroupMember(groupId) && 
                     isValidChatMediaType() &&
                     // Max 10MB per attachment
                     validFileSize(10 * 1024 * 1024);
    }

    // Path: /groups/{groupId}/voice/{filename}
    // Used for voice messages in group chats
    match /groups/{groupId}/voice/{allPaths=**} {
      allow read: if isGroupMember(groupId);
      allow write: if isGroupMember(groupId) && 
                     request.resource.contentType.matches('audio/.*') &&
                     // Max 10MB per voice message
                     validFileSize(10 * 1024 * 1024);
    }

    // Path: /groups/{groupId}/avatar/{filename}
    // Used for group profile pictures (set during creation or later)
    match /groups/{groupId}/avatar/{allPaths=**} {
      allow read: if isGroupMember(groupId);

      allow write: if isGroupMember(groupId) && 
                     isValidImageType() &&
                     // Max 5MB for group avatars
                     validFileSize(5 * 1024 * 1024);
    }

    // Path: /groups/{groupId}/background/{filename}
    // Used for group chat background images
    match /groups/{groupId}/background/{allPaths=**} {
      allow read: if isGroupMember(groupId);

      allow write: if isGroupMember(groupId) && 
                     isValidImageType() &&
                     // Max 10MB for background images
                     validFileSize(10 * 1024 * 1024);
    }

    // ============================================================
    // CHAT-STAGING: Temporary uploads before server commit (Segment 3)
    // ============================================================
    
    // Path: /chat-staging/{scope}/{conversationId}/{messageId}/{allPaths=**}
    // Client uploads here; server copies to chat-media on sendMessageV2.
    // Read is denied for clients — only the Admin SDK (server) reads these.
    match /chat-staging/{scope}/{conversationId}/{messageId}/{allPaths=**} {
      allow read: if false;
      allow write: if isConversationMember(scope, conversationId) &&
                     isValidChatMediaType() &&
                     validFileSize(25 * 1024 * 1024);
    }

    // ============================================================
    // CHAT-MEDIA: Final committed chat media (Segment 3)
    // ============================================================
    
    // Path: /chat-media/{scope}/{conversationId}/{messageId}/{allPaths=**}
    // Server-only: written by commitStagedAttachments, read via signed URLs.
    // Both read and write are denied for clients.
    match /chat-media/{scope}/{conversationId}/{messageId}/{allPaths=**} {
      allow read, write: if false;
    }

    // ============================================================
    // CATCH-ALL: Deny everything else
    // ============================================================
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

