# ── Colyseus Server Environment Variables ──────────────────────────
#
# Copy this file to .env for local development, or set these as
# Railway environment variables for production deployment.

# Port the server listens on. Railway injects this automatically.
# PORT=2567

# Bind address. Default 0.0.0.0 (all interfaces).
# HOST=0.0.0.0

# ── Firebase ────────────────────────────────────────────────────────

# Firebase project ID (default: gamerapp-37e70)
# FIREBASE_PROJECT_ID=gamerapp-37e70

# Option A (recommended for Railway / containers):
# Base64-encoded Firebase service account JSON key.
# Generate: base64 -w0 < service-account-key.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eX...

# Option B (local development):
# Path to service account JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ── Dev Bypass ──────────────────────────────────────────────────────

# Force dev bypass mode on (1) or off (0).
# When unset, auto-detects based on credential availability.
# MUST be set to 0 in production so room joins verify Firebase tokens.
# COLYSEUS_DEV_BYPASS=0
